# 6. Median-split interaction regressions (submitted slide 16) -----------------
h <- data
h$wealth_high <- as.numeric(h$BL_index_wealth > median(h$BL_index_wealth, na.rm = TRUE))
h$size_large <- as.numeric(h$BL_HH_number > median(h$BL_HH_number, na.rm = TRUE))
h1 <- feols(EL_care_GvtChw ~ treat * BL_GvtChw | area_code, data = h, vcov = ~village_codeU)
h2 <- feols(EL_care_GvtChw ~ treat * wealth_high | area_code, data = h, vcov = ~village_codeU)
h3 <- feols(EL_care_GvtChw ~ treat * size_large | area_code, data = h, vcov = ~village_codeU)
h4 <- feols(EL_care_GvtChw ~ treat * BL_scarce | area_code, data = h, vcov = ~village_codeU)
h5 <- feols(EL_care_GvtChw ~ treat * (BL_GvtChw + wealth_high + size_large + BL_scarce) | area_code,
             data = h, vcov = ~village_codeU)
fmt <- function(est, se) sprintf('%.3f (%.3f)', est, se)
group_effects <- function(m, v, label, lo, hi) {
  b <- coef(m); V <- vcov(m); int <- paste0('treat:', v)
  data.frame(Variable = label, Group_0 = lo, Effect_0 = fmt(b['treat'], sqrt(V['treat', 'treat'])),
    Group_1 = hi, Effect_1 = fmt(b['treat'] + b[int], sqrt(V['treat','treat'] + V[int,int] + 2*V['treat',int])),
    Difference = fmt(b[int], sqrt(V[int,int])), p_value = sprintf('%.3f', pvalue(m)[int]))
}
het_summary <- rbind(group_effects(h1, 'BL_GvtChw', 'Gov worker in 2010', 'No', 'Yes'),
  group_effects(h2, 'wealth_high', 'Village wealth', 'At/below median', 'Above median'),
  group_effects(h3, 'size_large', 'Village size', 'At/below median', 'Above median'),
  group_effects(h4, 'BL_scarce', 'Labor supply', 'Abundant', 'Scarce'))
rownames(het_summary) <- NULL
write_table(het_summary, 'Table4_heterogeneity')
pdf_table(het_summary, 'Table4_heterogeneity', 'Effect of NGO entry by baseline subgroup', 14, 3)
capture.output(summary(h5), file = output('Joint_subgroup_interactions.txt'))

# 7. Causal forests: preserve both submitted candidate sets -------------------
vars8 <- c('BL_GvtChw', 'BL_scarce', 'BL_care_GvtChw', 'BL_care_Hosp',
           'BL_Dist_PrivClinic10', 'BL_Dist_Hosp10', 'BL_HH_number', 'BL_index_wealth')
vars23 <- c(vars8, 'BL_care_TradHeal', 'BL_care_DrugStore', 'BL_care_PrivHospClin',
  'BL_farmer', 'BL_schoolopen', 'BL_nbattend', 'BL_Age_Head', 'BL_AbovePrimary',
  'BL_Number_Infants', 'BL_health_index', 'BL_TradHealer', 'BL_DrugStore',
  'BL_infants_per_HH', 'BL_infants_per_HH_died', 'BL_share_primary')
nice_names <- c(BL_GvtChw='Gov. worker', BL_scarce='Labor scarcity', BL_care_GvtChw='Care: gov. worker',
  BL_care_Hosp='Care: gov. clinic', BL_Dist_PrivClinic10='Private clinic nearby',
  BL_Dist_Hosp10='Gov. clinic nearby', BL_HH_number='Village size', BL_index_wealth='Wealth',
  BL_care_TradHeal='Care: healer', BL_care_DrugStore='Care: drug store', BL_care_PrivHospClin='Care: private clinic',
  BL_farmer='Farmer', BL_schoolopen='School open', BL_nbattend='Kids in school', BL_Age_Head="Head's age",
  BL_AbovePrimary="Head's education", BL_Number_Infants='HH infants', BL_health_index='Health behavior',
  BL_TradHealer='Healer in village', BL_DrugStore='Drug store in village',
  BL_infants_per_HH='Infants per HH', BL_infants_per_HH_died='Infant deaths', BL_share_primary='Share primary educ.')
W_hat <- ave(data$treat, data$area_code, FUN = mean)
stopifnot(all(W_hat > 0 & W_hat < 1))
fit_forest <- function(vars, tag) {
  X <- as.matrix(data[, vars, drop = FALSE])
  # grf handles missing predictor values natively; preserve submitted preprocessing.
  cf <- causal_forest(X, Y_clean, D_clean, W.hat = W_hat, clusters = as.integer(data$village_codeU),
                      tune.parameters = 'all', seed = 8675309)
  cal <- test_calibration(cf)
  calibration <- data.frame(Term = c('Mean forest pred.', 'Differential forest pred.'),
    Estimate = cal[,1], SE = cal[,2], p_value = cal[,4])
  write_table(calibration, paste0('Table5_calibration_', tag))
  displayed <- calibration; displayed[,2:3] <- round(displayed[,2:3], 3)
  displayed$p_value <- sprintf('%.3f', displayed$p_value)
  pdf_table(displayed, paste0('Table5_calibration_', tag), paste('Calibration test:', length(vars), 'covariates'), 7, 2)
  importance <- data.frame(variable = vars, importance = as.vector(variable_importance(cf)))
  importance <- importance[order(importance$importance, decreasing = TRUE), ]
  write_table(importance, paste0('Variable_importance_', tag))
  importance$variable <- factor(importance$variable, levels = rev(importance$variable))
  fig <- ggplot(importance, aes(x = importance, y = variable)) + geom_col(fill='steelblue') +
    scale_y_discrete(labels=nice_names) + labs(x='Variable importance', y=NULL,
      title=paste0('Variable Importance in Causal Forest (', length(vars), ' covariates)')) + theme_minimal(base_size=13)
  ggsave(output(paste0('Figure2_variable_importance_', tag, '.png')), fig, width=8,
         height=if (length(vars)>8) 6 else 4.5, dpi=300, bg='white')
  cate <- as.vector(predict(cf)$predictions)
  write_table(data.frame(village_codeU=data$village_codeU, CATE=cate), paste0('CATE_', tag))
  # All subgroup rows are drawn from the same data used to fit this forest.
  wm <- median(data$BL_index_wealth); sm <- median(data$BL_HH_number)
  groups <- list(All=rep(TRUE,nrow(data)), Gov_worker=data$BL_GvtChw==1, No_gov_worker=data$BL_GvtChw==0,
    Wealth_above_median=data$BL_index_wealth>wm, Wealth_at_below_median=data$BL_index_wealth<=wm,
    Village_size_above_median=data$BL_HH_number>sm, Village_size_at_below_median=data$BL_HH_number<=sm,
    Labor_scarce=data$BL_scarce==1, Labor_abundant=data$BL_scarce==0,
    CATE_above_median=cate>median(cate), CATE_at_below_median=cate<=median(cate))
  subgroup <- do.call(rbind,lapply(names(groups),function(nm) {
    ii <- which(groups[[nm]]); a <- average_treatment_effect(cf,subset=ii)
    data.frame(Group=nm,N=length(ii),Estimate=unname(a['estimate']),Std_Error=unname(a['std.err']))
  }))
  write_table(subgroup,paste0('Table3_causal_forest_',tag))
  if (length(vars)>8) {
    top_vars <- unique(c(as.character(importance$variable[1:10]), 'BL_GvtChw'))
    # Missing values in A are not accepted by BLP. Mean-impute only its projection covariates;
    # the forest itself keeps native missing-value handling. This repairs an original runtime error.
    A <- X[,top_vars,drop=FALSE]
    for (j in seq_len(ncol(A))) if (anyNA(A[,j])) A[is.na(A[,j]),j] <- mean(A[,j], na.rm=TRUE)
    stopifnot(all(is.finite(A)))
    blp <- best_linear_projection(cf,A)
    write_table(data.frame(Term=rownames(blp),as.data.frame(unclass(blp)),check.names=FALSE),'Best_linear_projection_23vars')
    capture.output(blp,file=output('Best_linear_projection_23vars.txt'))
  }
  list(forest=cf,calibration=cal,cate=cate,subgroup=subgroup)
}
message('Fitting 23-covariate forest...')
forest23 <- fit_forest(vars23,'23vars')
message('Fitting 8-covariate forest...')
forest8 <- fit_forest(vars8,'8vars')

