output <- function(name) file.path(out_dir, name)
write_table <- function(x, name) write.csv(x, output(paste0(name, '.csv')), row.names = FALSE)
# Base grid table export avoids needing the additional gridExtra package.
pdf_table <- function(x, name, title, width = 10, height = 3) {
  pdf(output(paste0(name, '.pdf')), width = width, height = height)
  on.exit(dev.off())
  grid::grid.newpage()
  grid::grid.text(title, y = .94, gp = grid::gpar(fontsize = 11, fontface = 'bold'))
  cells <- rbind(names(x), as.matrix(x)); nr <- nrow(cells); nc <- ncol(cells)
  weights <- apply(cells, 2, function(z) max(nchar(z), 5)); widths <- weights / sum(weights) * .96
  left <- .02 + c(0, cumsum(widths)[-nc]); h <- .76 / nr
  for (i in seq_len(nr)) for (j in seq_len(nc)) {
    y <- .84 - (i - .5) * h
    grid::grid.rect(x = left[j] + widths[j]/2, y = y, width = widths[j], height = h,
                    gp = grid::gpar(fill = if (i == 1) '#d6d6d6' else if (i %% 2) '#eeeeee' else 'white', col = 'white'))
    grid::grid.text(cells[i,j], x = left[j] + widths[j]/2, y = y,
                    gp = grid::gpar(fontsize = 9, fontface = if (i == 1) 'bold' else 'plain'))
  }
}

# 2. Data and validation -----------------------------------------------------
raw <- as.data.frame(zap_labels(read_dta(data_path)))
required <- c('EL_care_GvtChw', 'treat', 'area_code', 'village_codeU', 'BL_care_GvtChw')
stopifnot(all(required %in% names(raw)), all(na.omit(raw$treat) %in% c(0, 1)))
data <- raw[!is.na(raw$EL_care_GvtChw) & !is.na(raw$treat), , drop = FALSE]
stopifnot(!anyNA(data$area_code), !anyNA(data$village_codeU))
# Treatment must be constant within village.
stopifnot(all(vapply(split(data$treat, data$village_codeU), function(z) length(unique(z)) == 1L, logical(1))))
bl_vars <- grep('^BL_', names(raw), value = TRUE)
write_table(data.frame(Variable = bl_vars, Missing = colSums(is.na(raw[, bl_vars]))), 'Baseline_missingness')
write_table(data.frame(N_households = nrow(data), N_villages = length(unique(data$village_codeU)),
                       N_treated_villages = length(unique(data$village_codeU[data$treat == 1]))), 'Sample_counts')

# 2b. Authors' household-outcome specification (slide 6, columns 4-6) -----------
# Reconstructed from the notes in the authors' Table 3 shown on the slide.
# This is an addition: it was absent from the submitted script.
author_data <- data
author_data$private_dm <- author_data$BL_Dist_PrivClinic10 - mean(author_data$BL_Dist_PrivClinic10)
author_data$size_dm <- author_data$BL_HH_number - mean(author_data$BL_HH_number)
author_models <- lapply(c('EL_care_GvtChw', 'EL_care_BracChw', 'EL_care_CHW'), function(y)
  feols(as.formula(paste(y, '~ treat_BL_GvtChw + treat_BL_GvtChwNOT + BL_GvtChw +',
    'private_dm + size_dm + BL_GvtChw:private_dm + BL_GvtChw:size_dm | area_code')),
    data = author_data, vcov = ~village_codeU))
names(author_models) <- c('Government care', 'NGO care', 'Any worker care')
author_table <- do.call(rbind, lapply(names(author_models), function(nm) {
  m <- author_models[[nm]]; t <- coeftable(m)[c('treat_BL_GvtChw', 'treat_BL_GvtChwNOT'), , drop=FALSE]
  data.frame(Outcome=nm, Group=c('Gov worker at baseline', 'No gov worker at baseline'),
    Estimate=t[,1], Std_Error=t[,2], p_value=t[,4], N=nobs(m))
}))
write_table(author_table, 'Authors_Table3_household_columns')
capture.output(lapply(author_models, summary), file=output('Authors_specification_summaries.txt'))

# 3. Difference in means and ANCOVA ------------------------------------------
group_means <- do.call(rbind, lapply(split(data, data$treat), function(z)
  data.frame(treat = z$treat[1], mean_healthcare = mean(z$EL_care_GvtChw), observations = nrow(z))))
write_table(group_means, 'Treatment_control_means')
dim_model <- feols(EL_care_GvtChw ~ treat, data = data, vcov = ~village_codeU)
# Preserve the submitted ANCOVA's mean imputation + missing indicators.
ancova_data <- data
for (v in bl_vars) if (anyNA(ancova_data[[v]])) {
  ancova_data[[paste0(v, '_miss')]] <- as.numeric(is.na(ancova_data[[v]]))
  ancova_data[[v]][is.na(ancova_data[[v]])] <- mean(ancova_data[[v]], na.rm = TRUE)
}
# The submitted specification does not include those missing indicators.
ancova <- feols(EL_care_GvtChw ~ treat + BL_care_GvtChw | area_code,
                data = ancova_data, vcov = ~village_codeU)

# 4. PDS selection and the submitted fixed-effects refit ----------------------
Y_clean <- data$EL_care_GvtChw; D_clean <- data$treat
X_clean <- data[, bl_vars, drop = FALSE]
usable <- vapply(X_clean, function(z) length(unique(z[!is.na(z)])) > 1L, logical(1))
X_imputed <- makeX(X_clean[, usable, drop = FALSE], na.impute = TRUE)
X_imputed <- X_imputed[, apply(X_imputed, 2, function(z) var(z) > 0), drop = FALSE]
stopifnot(all(is.finite(X_imputed)))
set.seed(123)
pds_model <- rlassoEffect(x = X_imputed, y = Y_clean, d = D_clean,
                          method = 'double selection', post = TRUE)
# Separate selections for the slide's control list.
lasso_y <- rlasso(x = X_imputed, y = Y_clean, post = TRUE)
lasso_d <- rlasso(x = X_imputed, y = D_clean, post = TRUE)
selection <- data.frame(Variable = colnames(X_imputed), Outcome = as.logical(lasso_y$index),
                        Treatment = as.logical(lasso_d$index))
write_table(selection, 'PDS_selection')
sel <- colnames(X_imputed)[which(pds_model$selection.index)]
pds_df <- data.frame(EL_care_GvtChw = Y_clean, treat = D_clean,
                     area_code = data$area_code, village_codeU = data$village_codeU,
                     X_imputed[, sel, drop = FALSE])
names(pds_df) <- make.names(names(pds_df))
pds_formula <- as.formula(paste('EL_care_GvtChw ~', paste(c('treat', make.names(sel)), collapse = ' + '), '| area_code'))
pds_fe <- feols(pds_formula, data = pds_df, vcov = ~village_codeU)
column <- function(m, controls, fe) c(sprintf('%.3f', coef(m)['treat']),
  sprintf('(%.3f)', se(m)['treat']), controls, fe, format(nobs(m), big.mark = ','))
comparison <- data.frame(Statistic = c('NGO entry', 'Standard error', 'Controls', 'Area FE', 'N'),
  'Diff. in means' = column(dim_model, 'None', 'No'),
  ANCOVA = column(ancova, 'Baseline outcome', 'Yes'),
  'PDS lasso' = column(pds_fe, paste(length(sel), 'selected'), 'Yes'), check.names = FALSE)
write_table(comparison, 'Table2_comparison')
pdf_table(comparison, 'Table2_comparison', 'Effect of NGO entry on government health-worker care', 9, 3)

# 5. Requested continuous interaction regressions (ordinary lm) ---------------
