## HETEROGENEITY: interaction regressions ---------------------------
library(gridExtra)

h <- zap_labels(Data_Households)

# Median splits: 1 = above median, 0 = at or below median
h$wealth_high <- as.numeric(h$BL_index_wealth > median(h$BL_index_wealth))
h$size_large  <- as.numeric(h$BL_HH_number    > median(h$BL_HH_number))

h1 <- feols(EL_care_GvtChw ~ treat * BL_GvtChw | area_code,
            data = h, vcov = ~village_codeU)
h2 <- feols(EL_care_GvtChw ~ treat * wealth_high | area_code,
            data = h, vcov = ~village_codeU)
h3 <- feols(EL_care_GvtChw ~ treat * size_large | area_code,
            data = h, vcov = ~village_codeU)
h4 <- feols(EL_care_GvtChw ~ treat * BL_scarce | area_code,
            data = h, vcov = ~village_codeU)
h5 <- feols(EL_care_GvtChw ~ treat * BL_GvtChw + treat * wealth_high +
              treat * size_large + treat * BL_scarce | area_code,
            data = h, vcov = ~village_codeU)

## ---- Effect of NGO entry in each group (for the slides) ----
fmt <- function(est, se) sprintf("%.3f (%.3f)", est, se)

group_effects <- function(m, v, var_label, lo_label, hi_label) {
  b <- coef(m); V <- vcov(m); int <- paste0("treat:", v)
  data.frame(
    Variable    = var_label,
    Group_0     = lo_label,
    Effect_0    = fmt(b["treat"], sqrt(V["treat", "treat"])),
    Group_1     = hi_label,
    Effect_1    = fmt(b["treat"] + b[int],
                      sqrt(V["treat", "treat"] + V[int, int] + 2 * V["treat", int])),
    Difference  = fmt(b[int], sqrt(V[int, int])),
    p_value     = sprintf("%.3f", pvalue(m)[int])
  )
}

het_summary <- rbind(
  group_effects(h1, "BL_GvtChw",   "Gov worker in 2010", "No",           "Yes"),
  group_effects(h2, "wealth_high", "Village wealth",     "Below median", "Above median"),
  group_effects(h3, "size_large",  "Village size",       "Below median", "Above median"),
  group_effects(h4, "BL_scarce",   "Skilled labor",      "Abundant",     "Scarce")
)
rownames(het_summary) <- NULL
het_summary

pdf("Table4_heterogeneity.pdf", width = 13, height = 3)
