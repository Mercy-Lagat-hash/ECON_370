# Load packages
library(dplyr)
library(fixest)
library(haven)


# Load the household dataset
Data_Households <- read_dta("Data_Households.dta")

# Step 1: Prepare the data --------------------------------------------

# Keep only villages with a government health worker in 2010
# Remove observations with missing outcome, treatment, or village ID

data <- Data_Households %>%
  filter(
    !is.na(EL_care_GvtChw),
    !is.na(treat))


# Step 2: Calculate treatment and control means -----------------------

# Calculate average government healthcare receipt in 2012
# treat = 1: NGO treatment group
# treat = 0: control group

group_means <- data %>%
  group_by(treat) %>%
  summarise(
    mean_healthcare = mean(EL_care_GvtChw),
    observations = n(),
    .groups = "drop"
  )

# Display treatment and control means
print(group_means)


# Step 3: Calculate the difference in means ---------------------------

# Treatment effect = treatment mean - control mean

difference <- group_means$mean_healthcare[group_means$treat == 1] -
  group_means$mean_healthcare[group_means$treat == 0]

# Display the treatment effect
print(difference)
## =====================================================================
## COMPARISON TABLE: Diff. in means vs ANCOVA vs PDS lasso
## =====================================================================
library(gridExtra)

# (1) Difference in means, as a regression so it has a standard error
#     (gives exactly the same number as `difference` above)
dim_model <- feols(EL_care_GvtChw ~ treat, data = data, vcov = ~village_codeU)

# (2) ANCOVA: already estimated above as `ancova`

# (3) PDS lasso: rerun with the controls the lasso selected,
#     adding area FE and village-clustered SEs to match the other columns
sel       <- colnames(X_imputed)[pds_model$selection.index]
sel_clean <- make.names(sel)
sel

pds_df <- data.frame(
  EL_care_GvtChw = Y_clean,
  treat          = D_clean,
  area_code      = as.numeric(Household_data$area_code[keep]),
  village_codeU  = as.numeric(Household_data$village_codeU[keep]),
  X_imputed[, sel, drop = FALSE]
)
names(pds_df) <- make.names(names(pds_df))

pds_fe <- feols(
  as.formula(paste("EL_care_GvtChw ~ treat",
                   if (length(sel)) paste("+", paste(sel_clean, collapse = " + ")) else "",
                   "| area_code")),
  data = pds_df, vcov = ~village_codeU)

# ---- Build the table: estimate on top, SE underneath ----
column <- function(m, controls, fe) {
  c(sprintf("%.3f", coef(m)["treat"]),
    sprintf("(%.3f)", se(m)["treat"]),
    controls, fe,
    format(nobs(m), big.mark = ","))
}

comparison <- data.frame(
  " "              = c("NGO entry", "", "Controls", "Area FE", "N"),
  "Diff. in means" = column(dim_model, "None", "No"),
  "ANCOVA"         = column(ancova, "Baseline outcome", "Yes"),
  "PDS lasso"      = column(pds_fe, paste(length(sel), "selected"), "Yes"),
  check.names = FALSE
)
comparison

pdf("Table2_comparison.pdf", width = 7, height = 2.5)
grid.arrange(tableGrob(comparison, rows = NULL,
                       theme = ttheme_minimal(base_size = 11)),
             top = "Effect of NGO entry on government health-worker care")
dev.off()
